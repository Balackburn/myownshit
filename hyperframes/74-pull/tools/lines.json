[
 {
  "id": "L01",
  "who": "N",
  "text": "Ce mec est sorti avec son pull à l'envers.",
  "hl": [
   "pull",
   "l'envers."
  ]
 },
 {
  "id": "L02",
  "who": "N",
  "text": "Personne n'a osé lui dire.",
