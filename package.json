{
  "name": "react-molstruct",
  "version": "0.1.0",
  "description": "Zero-backend React components that resolve molecule names via PubChem PUG REST and render accurate 2D structure SVGs in-browser with RDKit.js (WASM).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "chemistry",
    "cheminformatics",
    "rdkit",
    "pubchem",
    "smiles",
    "molecule",
    "svg",
    "2d-depiction"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "test": "npm run build && node scripts/smoke-test.mjs && node scripts/e2e-react.mjs && node scripts/e2e-panel.mjs && node scripts/e2e-resolver.mjs && node scripts/visual-test.mjs",
    "copy-rdkit": "node scripts/copy-rdkit.mjs",
    "dev": "npm run copy-rdkit && vite --config vite.demo.config.ts",
    "build:demo": "npm run copy-rdkit && vite build --config vite.demo.config.ts"
  },
  "peerDependencies": {
    "openchemlib": ">=9",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "openchemlib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/inter": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.1.0",
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "gsap": "^3.15.0",
    "jsdom": "^29.1.1",
    "openchemlib": "^9.22.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0"
  }
}
