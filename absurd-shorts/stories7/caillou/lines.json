[
 {
  "id": "L01",
  "who": "N",
  "text": "Ce mec a adopté un caillou.",
  "hl": [
   "mec",
   "adopté",
   "caillou."
  ]
 },
 {
  "id": "L02",
  "who": "N",
  "text": "Il l'a appelé Gérard.",
  "hl": [
   "Gérard."
