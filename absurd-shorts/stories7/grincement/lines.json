[
 {
  "id": "L01",
  "who": "N",
  "text": "La porte de ce mec grince. Pour l'État, c'est une langue.",
  "hl": [
   "grince.",
   "langue."
  ]
 },
 {
  "id": "L02",
  "who": "N",
  "text": "Le voisin avait porté plainte pour bruit.",
  "hl": [
   "voisin",
   "plainte"
  ]
 },
 {
  "id": "L03",
  "who": "N",
  "text": "Trois linguistes sont formels : une langue parlée par une seule porte.",
  "hl": [
   "linguistes",
   "porte."
  ]
 },
 {
  "id": "L04",
  "who": "N",
  "text": "Langue menacée : interdiction de l'huiler.",
  "hl": [
   "menacée",
   "l'huiler."
  ]
 },
 {
  "id": "L05",
  "who": "N",
  "text": "Les gendarmes ont saisi sa burette.",
  "hl": [
   "gendarmes",
   "burette."
  ]
 },
 {
  "id": "L06",
  "who": "N",
  "text": "Et fermer la porte, c'est lui couper la parole.",
  "hl": [
   "fermer",
   "parole."
  ]
 },
 {
  "id": "L07",
  "who": "N",
  "text": "Ce mec vit la porte ouverte. Il chauffe la rue.",
  "hl": [
   "ouverte.",
   "chauffe"
  ]
 },
 {
  "id": "L08",
  "who": "N",
  "text": "La nuit, elle parle dans son sommeil.",
  "hl": [
   "nuit,",
   "sommeil."
  ]
 },
 {
  "id": "L09",
  "who": "N",
  "text": "Tout le pays apprend le grincement. Obligatoire au bac.",
  "hl": [
   "grincement.",
   "bac."
  ]
 },
 {
  "id": "L10",
  "who": "N",
  "text": "Le voisin a été recalé trois fois. Il a déménagé.",
  "hl": [
   "recalé",
   "déménagé."
  ]
 },
 {
  "id": "L11",
  "who": "N",
  "text": "Le président a présenté ses vœux en grinçant.",
  "hl": [
   "vœux",
   "grinçant."
  ]
 },
 {
  "id": "L12",
  "who": "N",
  "text": "Dix ans plus tard, le dictionnaire est sorti.",
  "hl": [
   "Dix",
   "dictionnaire"
  ]
 },
 {
  "id": "L13",
  "who": "N",
  "text": "Mille pages. Un seul mot.",
  "hl": [
   "Mille",
   "mot."
  ]
 },
 {
  "id": "L14",
  "who": "N",
  "text": "Il veut dire : « De l'huile. »",
  "hl": [
   "dire",
   "l'huile."
  ]
 },
 {
  "id": "L15",
  "who": "N",
  "text": "Le président a donc souhaité de l'huile à tout le pays.",
  "hl": [
   "souhaité",
   "l'huile"
  ]
 },
 {
  "id": "L16",
  "who": "N",
  "text": "La burette est toujours sous scellés.",
  "hl": [
   "burette",
   "scellés."
  ]
 }
]