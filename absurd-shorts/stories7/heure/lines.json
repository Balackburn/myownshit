[
 {
  "id": "L01",
  "who": "N",
  "text": "Ce mec a refusé le changement d'heure.",
  "hl": [
   "mec",
   "refusé"
  ]
 },
 {
  "id": "L02",
  "who": "N",
  "text": "Il est resté à l'heure d'été.",
