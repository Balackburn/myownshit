[
 {
  "id": "L01",
  "who": "N",
  "text": "Ce mec attend au feu rouge.",
  "hl": [
   "feu",
   "rouge."
  ]
 },
 {
  "id": "L02",
  "who": "N",
  "text": "Le feu n'est jamais passé au vert.",
  "hl": [
   "jamais",
   "vert."
  ]
 },
 {
  "id": "L03",
  "who": "N",
  "text": "Ça fait douze ans.",
  "hl": [
   "douze",
   "ans."
  ]
 },
 {
  "id": "L04",
  "who": "N",
  "text": "Sa barbe touche le trottoir.",
  "hl": [
   "barbe"
  ]
 },
 {
  "id": "L05",
  "who": "N",
  "text": "La mairie lui a construit une maison sur le passage piéton.",
  "hl": [
   "maison"
  ]
 },
 {
  "id": "L06",
  "who": "N",
  "text": "Le facteur lui livre son courrier au feu.",
