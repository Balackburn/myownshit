   "policier"
  ]
 },
 {
  "id": "L08",
  "who": "N",
  "text": "Le policier a pris une amende.",
  "hl": [
   "amende."
  ]
 },
 {
  "id": "L09",
  "who": "N",
  "text": "Les pigeons ont fait un nid dans sa barbe.",
  "hl": [
   "nid"
  ]
 },
 {
  "id": "L10",
  "who": "N",
  "text": "Les touristes font la queue pour la photo.",
  "hl": [
   "touristes"
  ]
 },
 {
  "id": "L11",
  "who": "N",
  "text": "Le gouvernement l'a décoré pour sa patience.",
