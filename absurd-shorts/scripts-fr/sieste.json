   "lines": [
    {
     "id": "SI4",
     "text": "Le bureau était devenu un musée. Et ce mec, l'œuvre principale.",
     "highlight": [
      "musée.",
      "l'œuvre"
     ]
    },
    {
     "id": "SI5",
     "text": "Alors ce con a porté plainte pour séquestration.",
     "highlight": [
      "plainte",
      "séquestration."
     ]
    },
    {
     "id": "SI6",
     "text": "Le musée a gagné. Il est classé monument historique.",
     "highlight": [
      "monument",
      "historique."
     ]
    },
    {
     "id": "SI7",
     "text": "Il n'a plus le droit de bouger. Ni de bâiller.",
     "highlight": [
      "bouger.",
      "bâiller."
     ]
    },
    {
     "id": "SI8",
     "text": "Les visiteurs paient quinze euros pour le voir dormir.",
     "highlight": [
      "quinze",
      "dormir."
     ]
    },
    {
     "id": "SI9",
     "text": "Hier, il a mis un réveil. Cinq minutes.",
     "highlight": [
      "réveil.",
      "Cinq"
     ]
    },
    {
     "id": "SI10",
     "text": "Putain, il s'est rendormi.",
     "highlight": [
      "rendormi."
     ]
    }
