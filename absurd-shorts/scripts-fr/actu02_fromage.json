      "fromage."
     ]
    },
    {
     "id": "F6",
     "text": "Le fromage n'avait pas d'avis sur l'histoire chinoise.",
     "highlight": [
      "avis"
     ]
    },
    {
     "id": "F7",
     "text": "Il a appelé les flics. Motif : abandon de domicile.",
     "highlight": [
      "Motif",
      "domicile."
     ]
    },
    {
     "id": "F8",
     "text": "Les flics ont embarqué le fromage. Et ce mec, pour complicité.",
     "highlight": [
      "complicité."
     ]
    }
